# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Used by the postgres container itself
POSTGRES_DB=repopulse
POSTGRES_USER=repopulse
POSTGRES_PASSWORD=change-me-in-production

# ─── RabbitMQ ─────────────────────────────────────────────────────────────────
# Used by the rabbitmq container itself
RABBITMQ_USER=repopulse
RABBITMQ_PASS=change-me-in-production

# ─── Service connection URLs ───────────────────────────────────────────────────
# Used by api-service, ingestion-service, and recommender-service.
# When running inside Docker Compose, hostnames are the service names.
DATABASE_URL=postgresql://repopulse:change-me-in-production@postgres:5432/repopulse
RABBITMQ_URL=amqp://repopulse:change-me-in-production@rabbitmq:5672/

# ─── API Service ──────────────────────────────────────────────────────────────
API_DEBUG=false

# ─── Logging ──────────────────────────────────────────────────────────────────
# Set to DEBUG during development, INFO in production
LOG_LEVEL=INFO
# Set to false for human-readable logs during local development
LOG_JSON=true
